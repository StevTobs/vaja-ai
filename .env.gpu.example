# Windows NVIDIA GPU profile. Install requirements-gpu-windows.txt first.
APP_ENV=local
DATA_DIR=./data
MODEL_CACHE_DIR=./data/models
MODEL_LOCAL_FILES_ONLY=true
ASR_DEVICE=cuda
ASR_COMPUTE_TYPE=float16
ASR_LANGUAGE=th
ASR_VAD=true
ASR_BEAM_SIZE=5
# 8 = batched (validated with the Thai profile below on RTX 5050 8 GB).
ASR_BATCH_SIZE=8
# Thai fine-tune (Thonburian Whisper large-v3, CT2). Needs ~4 GB VRAM with float16 + fallback ~2 GB.
ASR_MODEL=Vinxscribe/biodatlab-whisper-th-large-v3-faster
ASR_TIMESTAMPS=false
ASR_CHUNK_LENGTH=10
# Thonburian sometimes emits memorized web text instead of the audio; those segments are re-decoded by the fallback.
ASR_HALLUCINATION_MARKERS=บอลสเต็ป|บอลเสต็ป|บอลเต็ง|ทีเด็ดฟุตบอล|วิเคราะห์บอล|A-TECHงานเลี้ยง|วงข้าวเปลือกแสดงสด
ASR_FALLBACK_MODEL=mobiuslabsgmbh/faster-whisper-large-v3-turbo
ASR_REPETITION_PENALTY=1.1
ASR_COLLAPSE_REPEATS=4
ASR_AUDIO_FILTER=highpass=f=100,dynaudnorm=f=150:g=15
ASR_CPU_THREADS=4

# --- AI transcript analysis (correction / summary / sentiment / topics) ---
# Off when empty. Comma-separated: ollama, claude_cli, claude_api
#   ollama     = local LLM via Ollama; transcript stays on this machine
#   claude_cli = headless Claude Code (`claude -p`) with your Claude Code login; sends transcript text to Anthropic
#   claude_api = Anthropic API (ANTHROPIC_API_KEY or `ant auth login`); sends transcript text to Anthropic
ANALYSIS_PROVIDERS=
ANALYSIS_TIMEOUT_SECONDS=900
OLLAMA_URL=http://127.0.0.1:11434
# Any Thai-capable model you have pulled, e.g. qwen3:8b (ollama pull qwen3:8b)
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=32768
CLAUDE_CLI_PATH=claude
# Claude Code model alias or full id (opus, sonnet, claude-opus-5-5)
CLAUDE_CLI_MODEL=opus
CLAUDE_API_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
ANTHROPIC_API_KEY=
