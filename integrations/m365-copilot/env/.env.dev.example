# Copy to .env.dev and fill in. These are identifiers, not secrets; never put client secrets or API keys here.
# New GUID per app, e.g. PowerShell: [guid]::NewGuid()
TEAMS_APP_ID=
# Public HTTPS URL of the VAJA AI reverse proxy (no trailing slash). Copilot calls it from Microsoft's cloud; localhost will not work.
VAJA_API_BASE_URL=https://vaja.example.org
VAJA_API_HOST=vaja.example.org
# Directory (tenant) ID of your Microsoft 365 organization.
AAD_TENANT_ID=
# Delegated scope exposed by the VAJA API app registration, e.g. api://<vaja-api-client-id>/Analyses.ReadWrite
VAJA_API_SCOPE=
# "Microsoft Entra SSO registration ID" from Teams developer portal (Tools > Microsoft Entra SSO client ID registration).
VAJA_ENTRA_SSO_AUTH_CONFIG_ID=
VAJA_PUBLISHER_NAME=
VAJA_WEBSITE_URL=https://vaja.example.org
VAJA_PRIVACY_URL=https://vaja.example.org/privacy
VAJA_TERMS_URL=https://vaja.example.org/terms
VAJA_CONTACT_EMAIL=
