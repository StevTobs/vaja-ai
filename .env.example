APP_ENV=local
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data
MAX_UPLOAD_MB=100
MAX_DURATION_SECONDS=7200
DISK_QUOTA_MB=10240
MIN_FREE_DISK_MB=256
# small is CPU-friendly but weak for Thai phone audio; on an NVIDIA GPU use .env.gpu.example (Thai fine-tune).
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=th
ASR_VAD=true
ASR_CPU_THREADS=4
# Keep 5 for search quality; 1 is faster but can change transcription accuracy.
ASR_BEAM_SIZE=5
# 1 = standard; try 8 on a verified CUDA GPU (uses more VRAM).
ASR_BATCH_SIZE=1
# Penalize repeated tokens to stop Whisper loops ("สวัสดีครับ สวัสดีครับ ..."); 1.0 disables.
ASR_REPETITION_PENALTY=1.1
ASR_NO_REPEAT_NGRAM_SIZE=0
# Collapse a phrase looped N+ times in a row to one copy; 0 disables.
ASR_COLLAPSE_REPEATS=4
# Optional domain vocabulary to bias spelling, e.g. "ค่าไฟ มิเตอร์ การไฟฟ้า บิล ประสานงาน"
ASR_INITIAL_PROMPT=
ASR_HOTWORDS=
# Copy for the model only (playback.wav stays original): cut rumble, even out quiet/loud speakers.
ASR_AUDIO_FILTER=highpass=f=100,dynaudnorm=f=150:g=15
# Decode window seconds (0 = model default 30); fine-tunes without timestamp tokens need ASR_TIMESTAMPS=false.
ASR_CHUNK_LENGTH=0
ASR_TIMESTAMPS=true
# "|"-separated memorized phrases; segments containing one are re-decoded by ASR_FALLBACK_MODEL or left out.
ASR_HALLUCINATION_MARKERS=
ASR_FALLBACK_MODEL=
MODEL_CACHE_DIR=./data/models
# Download explicitly once; worker stays offline afterward.
MODEL_LOCAL_FILES_ONLY=true
ASR_TIMEOUT_SECONDS=3600
WORKER_CONCURRENCY=1
FFMPEG_TIMEOUT_SECONDS=600
JOB_POLL_SECONDS=3
# Required for APP_ENV=server (minimum 32 characters); browser username: vaja
API_TOKEN=

# --- AI transcript analysis (correction / summary / sentiment / topics) ---
# Off when empty. Comma-separated: ollama, claude_cli, claude_api
#   ollama     = local LLM via Ollama; transcript stays on this machine
#   claude_cli = headless Claude Code (`claude -p`) with your Claude Code login; sends transcript text to Anthropic
#   claude_api = Anthropic API (ANTHROPIC_API_KEY or `ant auth login`); sends transcript text to Anthropic
ANALYSIS_PROVIDERS=
ANALYSIS_TIMEOUT_SECONDS=900
OLLAMA_URL=http://127.0.0.1:11434
# Any Thai-capable model you have pulled, e.g. qwen3:8b (ollama pull qwen3:8b)
OLLAMA_MODEL=qwen3:8b
OLLAMA_NUM_CTX=32768
CLAUDE_CLI_PATH=claude
# Claude Code model alias or full id (opus, sonnet, claude-opus-5-5)
CLAUDE_CLI_MODEL=opus
CLAUDE_API_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
CLAUDE_EFFORT=medium
ANTHROPIC_API_KEY=
